# Copy to .env and fill in. .env is gitignored/dockerignored and never baked into an image.
# Used only by the LLM-crafted path-traversal agent (docker compose reads it automatically).
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides:
# AGENT_MODEL=claude-opus-5-5
# AGENT_PAYLOADS=            # set to skip the LLM and use given payloads (self-test / fallback)
